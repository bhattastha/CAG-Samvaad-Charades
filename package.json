{
  "name": "hindi-charades",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @hc/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @hc/api seed",
    "scan:forbidden": "tsx scripts/scan-forbidden.ts",
    "e2e": "playwright test --project=chrome --project=phone-chrome"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15"
  }
}
