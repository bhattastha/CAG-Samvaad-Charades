# Hindi Charades — environment (names only; never commit values). See docs/RUNBOOK.md.
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
# postgres://user:pass@db:5432/hindi_charades in production; empty = embedded PGlite under .data/
DATABASE_URL=
JWT_SECRET=
PUBLIC_ORIGIN=https://localhost
COOKIE_SECURE=0
# Email OTP sender (nodemailer URL, e.g. smtps://user:pass@smtp.example.gov.in:465). Empty in dev = fixed code 123456.
SMTP_URL=
OTP_FROM=
# Optional: restrict sign-up to these domains, comma-separated (e.g. cag.gov.in)
ALLOWED_EMAIL_DOMAINS=
# Game managers (comma-separated emails) — role "manager"
ADMIN_EMAILS=
# BHASHINI / Dhruva (raw tokens, server-side only)
DHRUVA_ASR_KEY=
DHRUVA_NMT_KEY=
DHRUVA_TTS_KEY=
DHRUVA_TTS_SERVICE_ID=
DHRUVA_LLM_KEY=
DHRUVA_ASR_DATA_EVENT=data
ANUVAAD_XLIT_AUTH=
# Development only: let unverified seed pages be played as labelled sample content
SEED_ALLOW_UNVERIFIED=0
CHROME_PATH=
POSTGRES_PASSWORD=
SITE_ADDRESS=
